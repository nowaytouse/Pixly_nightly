{
  "id": "com.pixly.static2jxl",
  "version": "2.1.0",
  "platform": "all",
  "arch": "all",
  "name": "{{manifest.app.name}}",
  "logo": "./logo.png",
  "keywords": [
    "jpeg",
    "png",
    "bmp",
    "tiff",
    "tga",
    "jxl",
    "converter",
    "image",
    "lossless",
    "compression"
  ],
  "fallbackLanguage": "en",
  "languages": [
    "en",
    "zh_CN",
    "zh_TW",
    "ja_JP"
  ],
  "devTools": false,
  "main": {
    "url": "index.html",
    "width": 520,
    "height": 650,
    "minWidth": 480,
    "minHeight": 550,
    "frame": false,
    "vibrancy": true
  }
}
