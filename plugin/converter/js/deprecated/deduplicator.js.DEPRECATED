/**
 * PIXLY 媒体去重工具module
 * 依赖: PIXLY命名空间, Node.js APIs
 */
(function(window) {
    'use strict';
    
    window.PIXLY = window.PIXLY || {};
    
    /**
     * 媒体去重器
     */
    const MediaDeduplicator = {
        
        /**
         * 查找重复file
         * @param {Array<string>} files - filepath列表
         * @returns {Promise<Object>} - 去重Result
         */
        findDuplicates: async function(files) {
 console.log('[PIXLY Dedup] Starting to find duplicates...');
            
            const crypto = require('crypto');
            const fs = require('fs');
            const hashMap = new Map();
            const duplicates = [];
            
            for (const filePath of files) {
                try {
                    // calculationfile哈希
                    const hash = await this.computeHash(filePath);
                    
                    if (hashMap.has(hash)) {
                        // Found重复file
                        duplicates.push({
                            original: hashMap.get(hash),
                            duplicate: filePath,
                            hash: hash
                        });
                    } else {
                        hashMap.set(hash, filePath);
                    }
                } catch (error) {
 console.error(`[PIXLY Dedup] Process filefailed: ${filePath}`, error);
                }
            }
            
 console.log(`[PIXLY Dedup] Found ${duplicates.length} groups of duplicates`);
            
            return {
                total: files.length,
                unique: hashMap.size,
                duplicates: duplicates,
                duplicateCount: duplicates.length
            };
        },
        
        /**
         * calculationfileSHA256哈希
         * @param {string} filePath - filepath
         * @returns {Promise<string>} - file哈希值
         */
        computeHash: function(filePath) {
            return new Promise((resolve, reject) => {
                const crypto = require('crypto');
                const fs = require('fs');
                const hash = crypto.createHash('sha256');
                const stream = fs.createReadStream(filePath);
                
                stream.on('data', (data) => {
                    hash.update(data);
                });
                
                stream.on('end', () => {
                    resolve(hash.digest('hex'));
                });
                
                stream.on('error', (error) => {
                    reject(error);
                });
            });
        },
        
        /**
         * 移除重复file
         * @param {Array<Object>} duplicates - 重复file列表
         * @param {boolean} keepOriginal - is否保留原始file
         * @returns {Promise<Object>} - 移除Result
         */
        removeDuplicates: async function(duplicates, keepOriginal = true) {
 console.log('[PIXLY Dedup] Starting to remove duplicates...');
            
            const fs = require('fs');
            let removedCount = 0;
            let failedCount = 0;
            const errors = [];
            
            for (const dup of duplicates) {
                try {
                    const fileToRemove = keepOriginal ? dup.duplicate : dup.original;
                    
                    // Deletefile
                    fs.unlinkSync(fileToRemove);
                    removedCount++;
                    
 console.log(`[PIXLY Dedup] deleted: ${fileToRemove}`);
                } catch (error) {
                    failedCount++;
                    errors.push({
                        file: keepOriginal ? dup.duplicate : dup.original,
                        error: error.message
                    });
 console.error(`[PIXLY Dedup] Deletefailed:`, error);
                }
            }
            
 console.log(`[PIXLY Dedup] completed！deleted ${removedCount} files`);
            
            return {
                removedCount,
                failedCount,
                errors
            };
        },
        
        /**
         * Analysis重复file
         * @param {Array<Object>} duplicates - 重复file列表
         * @returns {Object} - AnalysisResult
         */
        analyzeDuplicates: function(duplicates) {
            const fs = require('fs');
            let totalWastedSpace = 0;
            
            for (const dup of duplicates) {
                try {
                    const stats = fs.statSync(dup.duplicate);
                    totalWastedSpace += stats.size;
                } catch (error) {
 console.error('[PIXLY Dedup] Analysisfailed:', error);
                }
            }
            
            return {
                duplicateCount: duplicates.length,
                wastedSpace: totalWastedSpace,
                wastedSpaceFormatted: this.formatBytes(totalWastedSpace)
            };
        },
        
        /**
         * 格式化字节大小
         */
        formatBytes: function(bytes) {
            if (bytes === 0) return '0 B';
            const k = 1024;
            const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        },
        
        /**
         * Get files from Eagle并查找重复
         */
        findDuplicatesFromEagle: async function() {
 console.log('[PIXLY Dedup] Get files from Eagle...');
            
            try {
                // 获取EagleSelectedfile
                const items = await eagle.item.getSelected();
                
                if (!items || items.length === 0) {
 console.warn('[PIXLY Dedup] No files selected');
                    return {
                        total: 0,
                        unique: 0,
                        duplicates: [],
                        duplicateCount: 0
                    };
                }
                
                // 提取filepath
                const filePaths = items.map(item => item.filePath).filter(Boolean);
                
                // 查找重复
                return await this.findDuplicates(filePaths);
            } catch (error) {
 console.error('[PIXLY Dedup] Get files from Eaglefailed:', error);
                throw error;
            }
        }
    };
    
    // 暴露to全局
    PIXLY.MediaDeduplicator = MediaDeduplicator;
    
    // 向后兼容
    window.findDuplicates = function(files) {
        return MediaDeduplicator.findDuplicates(files);
    };
    
    window.removeDuplicates = function(duplicates, keepOriginal) {
        return MediaDeduplicator.removeDuplicates(duplicates, keepOriginal);
    };
    
 console.log('[PIXLY Dedup] Media Deduplication module loaded');
    
})(window);
