/**
 * ==========================================
 * PIXLY Log Manager
 * ==========================================
 *
 * 统一日志系统，支持日志级别控制
 *
 * 功能:
 * - 统一日志接口
 * - 日志级别控制 (DEBUG/INFO/WARN/ERROR)
 * - 性能监控
 * - 日志输出格式化
 * - 生产环境日志过滤
 *
 * @module LogManager
 * @version 1.0.0
 * @date 2025-11-05
 */

(function() {
    'use strict';

    /**
     * 日志级别枚举
     */
    const LogLevel = {
        DEBUG: 0,
        INFO: 1,
        WARN: 2,
        ERROR: 3,
        NONE: 4
    };

    /**
     * 日志管理器配置
     */
    const LOG_CONFIG = {
        // 当前日志级别 (可通过环境变量或配置覆盖)
        level: LogLevel.INFO,
        
        // 是否显示时间戳
        showTimestamp: true,
        
        // 是否显示模块名
        showModule: true,
        
        // 生产环境自动降级
        productionLevel: LogLevel.WARN,
        
        // 最大日志缓存数量
        maxLogs: 1000,
        
        // 性能监控阈值（毫秒）
        slowThreshold: 1000
    };

    /**
     * 统一日志管理器
     */
    class LogManager {
        constructor(config = {}) {
            this.config = { ...LOG_CONFIG, ...config };
            this.logs = [];
            this.stats = {
                debug: 0,
                info: 0,
                warn: 0,
                error: 0
            };
            
            // 检测环境
            this._detectEnvironment();
        }

        /**
         * 检测运行环境
         * @private
         */
        _detectEnvironment() {
            // 如果是生产环境，自动提升日志级别
            const isProduction = this._isProduction();
            if (isProduction && this.config.level < this.config.productionLevel) {
                this.config.level = this.config.productionLevel;
                console.info('[LogManager] Production mode detected, log level set to WARN');
            }
            
            // 支持配置系统覆盖
            if (window.CONFIG?.logging?.level !== undefined) {
                this.config.level = window.CONFIG.logging.level;
            }
        }

        /**
         * 判断是否为生产环境
         * @private
         */
        _isProduction() {
            try {
                if (typeof process !== 'undefined' && process.env?.NODE_ENV === 'production') {
                    return true;
                }
            } catch (e) {
                // 忽略
            }
            return false;
        }

        /**
         * 格式化日志消息
         * @private
         */
        _format(level, module, ...args) {
            const parts = [];
            
            // 时间戳
            if (this.config.showTimestamp) {
                const now = new Date();
                const timestamp = now.toTimeString().split(' ')[0];
                parts.push(`[${timestamp}]`);
            }
            
            // 日志级别
            const levelNames = ['DEBUG', 'INFO', 'WARN', 'ERROR'];
            parts.push(`[${levelNames[level]}]`);
            
            // 模块名
            if (this.config.showModule && module) {
                parts.push(`[${module}]`);
            }
            
            return [parts.join(' '), ...args];
        }

        /**
         * 记录日志
         * @private
         */
        _log(level, module, ...args) {
            // 检查日志级别
            if (level < this.config.level) {
                return;
            }
            
            // 格式化消息
            const formatted = this._format(level, module, ...args);
            
            // 输出到控制台
            const consoleMethods = ['debug', 'info', 'warn', 'error'];
            const consoleMethod = consoleMethods[level];
            console[consoleMethod](...formatted);
            
            // 缓存日志（用于导出/分析）
            this.logs.push({
                timestamp: Date.now(),
                level,
                module,
                message: args
            });
            
            // 限制缓存大小
            if (this.logs.length > this.config.maxLogs) {
                this.logs.shift();
            }
            
            // 统计
            const levelNames = ['debug', 'info', 'warn', 'error'];
            this.stats[levelNames[level]]++;
        }

        /**
         * DEBUG级别日志
         */
        debug(module, ...args) {
            this._log(LogLevel.DEBUG, module, ...args);
        }

        /**
         * INFO级别日志
         */
        info(module, ...args) {
            this._log(LogLevel.INFO, module, ...args);
        }

        /**
         * WARN级别日志
         */
        warn(module, ...args) {
            this._log(LogLevel.WARN, module, ...args);
        }

        /**
         * ERROR级别日志
         */
        error(module, ...args) {
            this._log(LogLevel.ERROR, module, ...args);
        }

        /**
         * 性能计时开始
         */
        time(label, module = 'Performance') {
            const key = `${module}:${label}`;
            console.time(key);
            return key;
        }

        /**
         * 性能计时结束
         */
        timeEnd(key) {
            console.timeEnd(key);
        }

        /**
         * 测量函数执行时间
         */
        async measure(label, fn, module = 'Performance') {
            const start = performance.now();
            try {
                const result = await fn();
                const duration = performance.now() - start;
                
                if (duration > this.config.slowThreshold) {
                    this.warn(module, `⚠️ Slow operation: ${label} (${duration.toFixed(2)}ms)`);
                } else {
                    this.debug(module, `✓ ${label} (${duration.toFixed(2)}ms)`);
                }
                
                return result;
            } catch (error) {
                const duration = performance.now() - start;
                this.error(module, `❌ ${label} failed (${duration.toFixed(2)}ms):`, error);
                throw error;
            }
        }

        /**
         * 设置日志级别
         */
        setLevel(level) {
            this.config.level = level;
            this.info('LogManager', `Log level set to ${Object.keys(LogLevel)[level]}`);
        }

        /**
         * 获取统计信息
         */
        getStats() {
            return {
                ...this.stats,
                total: Object.values(this.stats).reduce((a, b) => a + b, 0),
                cached: this.logs.length,
                level: Object.keys(LogLevel)[this.config.level]
            };
        }

        /**
         * 导出日志
         */
        exportLogs(filter = {}) {
            let logs = [...this.logs];
            
            // 按级别过滤
            if (filter.level !== undefined) {
                logs = logs.filter(log => log.level >= filter.level);
            }
            
            // 按模块过滤
            if (filter.module) {
                logs = logs.filter(log => log.module === filter.module);
            }
            
            // 按时间范围过滤
            if (filter.since) {
                logs = logs.filter(log => log.timestamp >= filter.since);
            }
            
            return logs;
        }

        /**
         * 清空日志缓存
         */
        clear() {
            this.logs = [];
            this.info('LogManager', 'Log cache cleared');
        }
    }

    // ==========================================
    // 初始化
    // ==========================================

    const logManager = new LogManager(LOG_CONFIG);

    // 暴露到全局
    window.LogManager = logManager;
    window.LogLevel = LogLevel;

    // 兼容旧的Logger接口
    if (!window.Logger) {
        window.Logger = {
            debug: (...args) => logManager.debug('PIXLY', ...args),
            info: (...args) => logManager.info('PIXLY', ...args),
            warn: (...args) => logManager.warn('PIXLY', ...args),
            error: (...args) => logManager.error('PIXLY', ...args)
        };
    }

    console.info('[PIXLY Log Manager] ✅ Initialized');
    console.info('[PIXLY Log Manager] 💡 Use window.LogManager.info(module, ...messages)');
    console.info(`[PIXLY Log Manager] 📊 Current level: ${Object.keys(LogLevel)[logManager.config.level]}`);

})();
