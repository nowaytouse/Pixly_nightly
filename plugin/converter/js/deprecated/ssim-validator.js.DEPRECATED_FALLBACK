/**
 * ╔════════════════════════════════════════════════════════════╗
 * ║   SSIM质量validatemodule v4.2.0                                   ║
 * ║   结构相似性validate + AI动态阈值调整                          ║
 * ╚════════════════════════════════════════════════════════════╝
 */

(function(window) {
    'use strict';

    /**
     * SSIMvalidateconfig
     */
    const SSIMConfig = {
        // 不同Optimize模式SSIM阈值
        thresholds: {
            size: {
                min: 0.90,      // 体积优先：可接受更低SSIM
                target: 0.93,   // 目标SSIM
                retry: true     // 低于min时retry
            },
            balanced: {
                min: 0.94,      // 平衡模式：中等SSIM要求
                target: 0.96,
                retry: true
            },
            quality: {
                min: 0.97,      // 质量优先：高SSIM要求
                target: 0.99,
                retry: true
            },
            universal: {
                min: 0.95,      // 通用模式
                target: 0.97,
                retry: false    // 无损模式不retry
            }
        },

        // 质量调整步长
        qualityStep: {
            small: 2,   // 小步长（接近阈值）
            medium: 5,  // 中步长
            large: 10   // 大步长（远低于阈值）
        },

        // 最大retry次数
        maxRetries: 3,

        // SSIMcalculation超时
        timeout: 10000  // 10秒
    };

    /**
     * SSIMvalidate器
     */
    class SSIMValidator {
        constructor() {
            this.config = SSIMConfig;
            this.retryHistory = new Map();  // recordretry历史
        }

        /**
         * validateConvert质量
         * @param {string} originalPath - 原始图像path
         * @param {string} convertedPath - Convert后图像path
         * @param {Object} options - validateoptions
         * @returns {Promise<Object>} validateResult
         */
        async validate(originalPath, convertedPath, options = {}) {
            const {
                mode = 'balanced',
                currentQuality = 90,
                aiFeatures = null,
                retryCount = 0
            } = options;

            const Logger = window.PIXLY?.Logger || console;
            Logger.debug(`🔬 SSIMvalidate | 模式=${mode} | 质量=${currentQuality} | retry=${retryCount}`);

            try {
                // calculationSSIM
                const ssim = await this.calculateSSIM(originalPath, convertedPath);
                
                // 获取阈值（AI动态调整）
                const threshold = this.getThreshold(mode, aiFeatures);
                
                // 判断is否passed
                const passed = ssim >= threshold.min;
                const excellent = ssim >= threshold.target;

                const result = {
                    ssim: ssim,
                    threshold: threshold,
                    passed: passed,
                    excellent: excellent,
                    mode: mode,
                    quality: currentQuality,
                    retryCount: retryCount
                };

                if (excellent) {
                    Logger.success(`✅ SSIMvalidatepassed | SSIM=${ssim.toFixed(4)} (优秀) | 阈值=${threshold.target.toFixed(2)}`);
                } else if (passed) {
                    Logger.info(`✅ SSIMvalidatepassed | SSIM=${ssim.toFixed(4)} (合格) | 阈值=${threshold.min.toFixed(2)}`);
                } else {
                    Logger.warn(`⚠️  SSIMvalidate未passed | SSIM=${ssim.toFixed(4)} < ${threshold.min.toFixed(2)}`);
                    
                    // 建议retry
                    if (threshold.retry && retryCount < this.config.maxRetries) {
                        result.shouldRetry = true;
                        result.suggestedQuality = this.suggestQuality(currentQuality, ssim, threshold, aiFeatures);
                        Logger.info(`💡 建议retry | New质量=${result.suggestedQuality}`);
                    }
                }

                return result;
                
            } catch (error) {
                Logger.error(`❌ SSIMvalidatefailed: ${error.message}`);
                return {
                    ssim: 0,
                    passed: false,
                    error: error.message,
                    fallback: true
                };
            }
        }

        /**
         * calculationSSIM（调用Go核心or降级方案）
         * @param {string} original - 原始图像
         * @param {string} converted - Convert后图像
         * @returns {Promise<number>} SSIM值 (0-1)
         */
        async calculateSSIM(original, converted) {
            // 方案1: try调用Go核心API
            try {
                const goResult = await this.calculateSSIMviaGo(original, converted);
                if (goResult !== null) {
                    return goResult;
                }
            } catch (error) {
                Logger.debug(`Go核心SSIMnot available: ${error.message}`);
            }

            // 方案2: try调用Python脚本
            try {
                const pythonResult = await this.calculateSSIMviaPython(original, converted);
                if (pythonResult !== null) {
                    return pythonResult;
                }
            } catch (error) {
                Logger.debug(`Python SSIMnot available: ${error.message}`);
            }

            // 方案3: 降级to快速估算
            Logger.warn('⚠️  SSIMservicenot available，使用快速估算');
            return await this.estimateSSIM(original, converted);
        }

        /**
         * passedGo核心calculationSSIM
         */
        async calculateSSIMviaGo(original, converted) {
            // CheckAIserviceis否available
            const aiServiceInfo = window.PIXLY?.UIHandlers?.pixlyGoServiceInfo;
            if (!aiServiceInfo || !aiServiceInfo.available) {
                return null;
            }
            
            try {
                const http = require('http');
                const fs = require('fs');
                const FormData = require('form-data');
                
                // create表单data
                const form = new FormData();
                form.append('original', fs.createReadStream(original));
                form.append('converted', fs.createReadStream(converted));
                
                // 发送请求toGoservice
                const result = await new Promise((resolve, reject) => {
                    const timeout = setTimeout(() => reject(new Error('timeout')), 10000);
                    
                    const req = http.request({
                        hostname: '127.0.0.1',
                        port: aiServiceInfo.port,
                        path: '/api/v1/ssim',
                        method: 'POST',
                        headers: form.getHeaders()
                    }, (res) => {
                        clearTimeout(timeout);
                        let data = '';
                        res.on('data', chunk => data += chunk);
                        res.on('end', () => {
                            try {
                                const parsed = JSON.parse(data);
                                if (parsed.ssim !== undefined) {
                                    resolve(parsed.ssim);
                                } else {
                                    reject(new Error('Invalid response'));
                                }
                            } catch (e) {
                                reject(e);
                            }
                        });
                    });
                    
                    req.on('error', reject);
                    form.pipe(req);
                });
                
                Logger.info(`✅ Go核心SSIMcalculationsuccessfully: ${result.toFixed(4)}`);
                return result;
            } catch (error) {
                Logger.debug(`Go核心SSIM调用failed: ${error.message}`);
                return null;
            }
        }

        /**
         * passedPython脚本calculationSSIM
         */
        async calculateSSIMviaPython(original, converted) {
            // 调用Python SSIMcalculation脚本
            const { exec } = require('child_process');
            const util = require('util');
            const execPromise = util.promisify(exec);

            const command = `python3 tools/calculate_ssim.py "${original}" "${converted}"`;
            
            const { stdout } = await execPromise(command, { timeout: this.config.timeout });
            const ssim = parseFloat(stdout.trim());
            
            if (isNaN(ssim) || ssim < 0 || ssim > 1) {
                throw new Error('Invalid SSIM value');
            }
            
            return ssim;
        }

        /**
         * 估算SSIM（降级方案）
         * 基于file大小and质量parameter快速估算
         */
        async estimateSSIM(original, converted) {
            const fs = require('fs');
            
            const originalSize = fs.statSync(original).size;
            const convertedSize = fs.statSync(converted).size;
            
            const compressionRatio = convertedSize / originalSize;
            
            // 简单估算：压缩率越高，SSIMmay越低
            // 这只is粗略估算，cannot替代真实SSIMcalculation
            let estimatedSSIM = 0.95;
            
            if (compressionRatio < 0.3) {
                estimatedSSIM = 0.92;  // 高压缩
            } else if (compressionRatio < 0.5) {
                estimatedSSIM = 0.94;  // 中压缩
            } else if (compressionRatio < 0.7) {
                estimatedSSIM = 0.96;  // 低压缩
            } else {
                estimatedSSIM = 0.98;  // 极低压缩
            }
            
            Logger.debug(`📊 SSIM估算 | 压缩率=${(compressionRatio * 100).toFixed(1)}% | 估算SSIM=${estimatedSSIM.toFixed(4)}`);
            
            return estimatedSSIM;
        }

        /**
         * 获取SSIM阈值（支持AI动态调整）
         * @param {string} mode - Optimize模式
         * @param {Object} aiFeatures - AI特征
         * @returns {Object} 阈值config
         */
        getThreshold(mode, aiFeatures) {
            const baseThreshold = this.config.thresholds[mode] || this.config.thresholds.balanced;
            
            // 无AI特征，返回基础阈值
            if (!aiFeatures || !aiFeatures.swt) {
                return baseThreshold;
            }

            // AI动态调整
            const { compressionScore, textureComplexity, noiseLevel } = aiFeatures.swt;
            
            let minAdjust = 0;
            let targetAdjust = 0;

            // 高可压缩性图像：can略微放宽阈值
            if (compressionScore > 0.8) {
                minAdjust -= 0.01;
                targetAdjust -= 0.01;
            }

            // 高纹理复杂度：need更严格阈值
            if (textureComplexity > 80) {
                minAdjust += 0.02;
                targetAdjust += 0.02;
            }

            // 高噪声：can略微放宽阈值
            if (noiseLevel > 30) {
                minAdjust -= 0.01;
            }

            const adjustedThreshold = {
                min: Math.max(0.85, Math.min(0.99, baseThreshold.min + minAdjust)),
                target: Math.max(0.90, Math.min(1.0, baseThreshold.target + targetAdjust)),
                retry: baseThreshold.retry
            };

            if (minAdjust !== 0 || targetAdjust !== 0) {
                Logger.debug(`🧠 AI调整SSIM阈值 | min: ${baseThreshold.min.toFixed(2)} → ${adjustedThreshold.min.toFixed(2)} | target: ${baseThreshold.target.toFixed(2)} → ${adjustedThreshold.target.toFixed(2)}`);
            }

            return adjustedThreshold;
        }

        /**
         * 建议retry质量
         * @param {number} currentQuality - 当前质量
         * @param {number} currentSSIM - 当前SSIM
         * @param {Object} threshold - 阈值
         * @param {Object} aiFeatures - AI特征
         * @returns {number} 建议New质量值
         */
        suggestQuality(currentQuality, currentSSIM, threshold, aiFeatures) {
            const ssimGap = threshold.min - currentSSIM;
            
            // 根据SSIM差距决定步长
            let qualityIncrease;
            if (ssimGap > 0.05) {
                qualityIncrease = this.config.qualityStep.large;
            } else if (ssimGap > 0.02) {
                qualityIncrease = this.config.qualityStep.medium;
            } else {
                qualityIncrease = this.config.qualityStep.small;
            }

            // AI微调：根据图像特征调整步长
            if (aiFeatures && aiFeatures.swt) {
                const { textureComplexity } = aiFeatures.swt;
                
                // 高纹理复杂度：need更大质量提升
                if (textureComplexity > 80) {
                    qualityIncrease += 2;
                }
            }

            const newQuality = Math.min(100, currentQuality + qualityIncrease);
            
            return newQuality;
        }

        /**
         * 批量validate（带进度反馈）
         * @param {Array} files - file对列表 [{original, converted, options}]
         * @param {Function} progressCallback - 进度回调
         * @returns {Promise<Array>} validateResult数组
         */
        async validateBatch(files, progressCallback = null) {
            const results = [];
            
            for (let i = 0; i < files.length; i++) {
                const { original, converted, options } = files[i];
                
                if (progressCallback) {
                    progressCallback(i, files.length, original);
                }
                
                const result = await this.validate(original, converted, options);
                results.push(result);
            }
            
            return results;
        }
    }

    // ============================================================
    // 导出
    // ============================================================

    const validator = new SSIMValidator();

    window.SSIMValidator = SSIMValidator;
    window.ssimValidator = validator;

    // 便捷函数
    window.validateSSIM = async function(original, converted, options) {
        return await validator.validate(original, converted, options);
    };

    window.validateSSIMBatch = async function(files, progressCallback) {
        return await validator.validateBatch(files, progressCallback);
    };

 console.log('[PIXLY] 🔬 SSIM quality Validation module loaded');

})(window);
