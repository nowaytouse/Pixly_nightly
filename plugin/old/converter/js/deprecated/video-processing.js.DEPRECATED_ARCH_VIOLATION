(function(window) {
    'use strict';
    
 console.log('[PIXLY Video Enhanced] 🎬 Enhanced video module loading...');
    
    const fs = require('fs');
    const path = require('path');
    const { spawn, exec } = require('child_process');
    const { promisify } = require('util');
    const execAsync = promisify(exec);
    
    // 确保全局objectexists
    if (!window.PIXLY) window.PIXLY = {};
    
    // 添加log辅助函数
    function addLog(message, type = 'info') {
        if (window.addLog) {
            window.addLog(message, type);
        }
 console.log(`[PIXLY Video] ${message}`);
    }
    
        /**
     * 🔍 Probe video info (使用ffprobe)
     */
    async function detectVideoInfo(videoPath) {
        // 🔥 参数验证
        if (!videoPath || typeof videoPath !== 'string') {
            console.error('[PIXLY Video] ❌ Invalid videoPath:', videoPath);
            return null;
        }
        
        console.log(`[PIXLY Video] 🔍 Probe video info: ${path.basename(videoPath)}`);
        
        const env = Object.assign({}, process.env);
        env.PATH = `/opt/homebrew/bin:/usr/local/bin:/usr/bin:${env.PATH || ''}`;
        
        try {
            const { stdout } = await execAsync(
                `ffprobe -v error -show_entries format=duration,size:stream=width,height,r_frame_rate,codec_name,codec_type -of json "${videoPath}"`,
                { maxBuffer: 10 * 1024 * 1024, env }
            );
            
            const probeData = JSON.parse(stdout);
            const videoStream = probeData.streams?.find(s => s.codec_type === 'video');
            const audioStream = probeData.streams?.find(s => s.codec_type === 'audio');
            const format = probeData.format;
            
            if (!videoStream) {
                throw new Error('No video stream found');
            }
            
            // calculation帧率
            let fps = 0;
            if (videoStream.r_frame_rate) {
                const [num, den] = videoStream.r_frame_rate.split('/').map(Number);
                fps = Math.round((num / den) * 100) / 100;
            }
            
            const videoInfo = {
                width: videoStream.width,
                height: videoStream.height,
                fps: fps,
                duration: parseFloat(format.duration || 0),
                videoCodec: videoStream.codec_name,
                audioCodec: audioStream ? audioStream.codec_name : 'none',
                hasAudio: !!audioStream,
                size: parseInt(format.size || 0),
                sizeMB: (parseInt(format.size || 0) / 1024 / 1024).toFixed(2)
            };
            
            return videoInfo;
        } catch (error) {
 console.error(`[PIXLY Video] ❌ Probe video infofailed:`, error);
            return null;
        }
    }
    
    /**
     * 🎥 Convert animation to video (支持多种编码器)
     * 基于 dynamic2mov 工具
     * 
     * @param {Array} files - file列表
     * @param {Object} options - options
     * @param {string} options.codec - 编码器: h264, h265, av1, prores, h266
     * @param {number} options.quality - 质量/CRF值
     * @param {string} options.preset - 编码预设
     * @param {number} options.fps - 帧率
     * @param {string} options.container - 容器格式: mp4, mov, webm
     */
        async function convertAnimatedToVideo(files, options = {}) {
        const {
            codec = 'h265',  // 默认H.265更高效
            quality = 23,
            preset = 'medium',
            fps = null,  // 🔒 默认null，维持原帧率
            container = 'mp4',
            proResProfile = 'standard'
        } = options;
        
        const Logger = window.PIXLY?.Logger || console;
        Logger.info(`[PIXLY Video] 🎥 Converting animation to video: ${files.length} files`);
        Logger.info(`[PIXLY Video] 📊 Codec=${codec.toUpperCase()}, Quality=${quality}, FPS=${fps || 'original'}, Container=${container}`);
        addLog(`🎥 转换动图为视频 (${codec.toUpperCase()}, 质量:${quality}, FPS:${fps || '保持原帧率'})`, 'info');
        
        const results = { success: 0, failed: 0, errors: [], outputFiles: [] };
        
        for (const file of files) {
            try {
                const inputPath = file.filePath || file.path;
                const inputExt = path.extname(inputPath);
                const baseName = path.basename(inputPath, inputExt);
                
                // 确定输出扩展名
                let outputExt = container === 'mov' ? '.mov' : 
                               container === 'webm' ? '.webm' : '.mp4';
                
                // ProResmust用MOV
                if (codec === 'prores') outputExt = '.mov';
                
                // 🔥 先输出到临时文件（避免文件名冲突），稍后会重命名
                const tempOutputPath = path.join(path.dirname(inputPath), `${baseName}_temp${outputExt}`);
                const finalOutputPath = path.join(path.dirname(inputPath), `${baseName}${outputExt}`);
                
                console.log(`[PIXLY Video] Converting: ${path.basename(inputPath)} → ${codec.toUpperCase()}`);
                
                const args = buildFFmpegArgs(inputPath, tempOutputPath, {
                    codec,
                    quality,
                    preset,
                    fps,
                    proResProfile
                });
                
                await executeFFmpeg(args);
                
                // 🔥 原地替换：删除原文件，重命名新文件
                const fs = require('fs');
                if (fs.existsSync(inputPath)) {
                    fs.unlinkSync(inputPath);
                    console.log(`[PIXLY Video] 🗑️ Deleted original: ${path.basename(inputPath)}`);
                }
                fs.renameSync(tempOutputPath, finalOutputPath);
                console.log(`[PIXLY Video] ✅ Renamed to: ${path.basename(finalOutputPath)}`);
                
                // 🔥 更新 Eagle metadata.json
                // Eagle 文档参考: https://cn.eagle.cool/support/article/why-do-some-images-generate-extra-thumbnails
                // Eagle API: https://developer.eagle.cool/plugin-api/v/zh-cn
                try {
                    const metadataPath = path.join(path.dirname(inputPath), 'metadata.json');
                    if (fs.existsSync(metadataPath)) {
                        const metadata = JSON.parse(fs.readFileSync(metadataPath, 'utf8'));
                        
                        // 获取新文件信息
                        const stats = fs.statSync(finalOutputPath);
                        const newExt = outputExt.slice(1); // 去掉点
                        const oldExt = path.extname(inputPath).slice(1); // 原扩展名
                        const newFileName = path.basename(finalOutputPath); // 新文件名（包括扩展名）
                        
                        // 🔥 关键修复：更新文件名和扩展名
                        metadata.name = newFileName;
                        metadata.ext = newExt;
                        metadata.size = stats.size;
                        metadata.mtime = stats.mtimeMs;
                        metadata.lastModified = Date.now();
                        metadata.modificationTime = Date.now();
                        
                        console.log(`[PIXLY Video] 📝 Updated metadata: name="${newFileName}", ext="${newExt}"`);
                        
                        // 获取视频尺寸（使用 ffprobe）
                        try {
                            const { spawn } = require('child_process');
                            const ffprobePath = getFFmpegPath().replace('ffmpeg', 'ffprobe');
                            
                            const videoInfo = await new Promise((resolve, reject) => {
                                const proc = spawn(ffprobePath, [
                                    '-v', 'quiet',
                                    '-print_format', 'json',
                                    '-show_streams',
                                    '-select_streams', 'v:0',
                                    finalOutputPath
                                ]);
                                
                                let stdout = '';
                                proc.stdout.on('data', (data) => { stdout += data; });
                                proc.on('close', (code) => {
                                    if (code === 0) {
                                        try {
                                            const info = JSON.parse(stdout);
                                            resolve(info.streams[0]);
                                        } catch (e) {
                                            reject(e);
                                        }
                                    } else {
                                        reject(new Error('ffprobe failed'));
                                    }
                                });
                            });
                            
                            if (videoInfo && videoInfo.width && videoInfo.height) {
                                metadata.width = videoInfo.width;
                                metadata.height = videoInfo.height;
                            }
                        } catch (probeError) {
                            console.warn(`[PIXLY Video] ⚠️ Failed to get video dimensions: ${probeError.message}`);
                        }
                        
                        // 写回 metadata.json
                        fs.writeFileSync(metadataPath, JSON.stringify(metadata, null, 2), 'utf8');
                        console.log(`[PIXLY Video] ✅ Updated Eagle metadata.json`);
                        addLog(`   📝 已更新 Eagle 元数据`, 'success');
                        
                        // 🔄 清除旧缩略图（如果扩展名改变）
                        // Eagle会自动重新生成缩略图
                        // 参考: https://cn.eagle.cool/support/article/why-do-some-images-generate-extra-thumbnails
                        if (oldExt !== newExt) {
                            const thumbnailPattern = `${baseName}.${oldExt}_thumbnail`;
                            const dirPath = path.dirname(inputPath);
                            const thumbnailPath = path.join(dirPath, thumbnailPattern);
                            
                            // 删除可能存在的缩略图文件
                            if (fs.existsSync(thumbnailPath)) {
                                try {
                                    fs.unlinkSync(thumbnailPath);
                                    console.log(`[PIXLY Video] 🗑️ Deleted old thumbnail: ${thumbnailPattern}`);
                                } catch (thumbError) {
                                    console.warn(`[PIXLY Video] ⚠️ Could not delete old thumbnail: ${thumbError.message}`);
                                }
                            }
                        }
                    }
                    
                    results.success++;
                    results.outputFiles.push(finalOutputPath);
                    addLog(`   ✅ ${path.basename(finalOutputPath)}`, 'success');
                    
                } catch (metaError) {
                    console.error(`[PIXLY Video] ❌ Metadata update failed: ${metaError.message}`);
                    addLog(`   ⚠️ 元数据更新失败: ${metaError.message}`, 'warning');
                    // 即使元数据更新失败，文件也已转换成功
                    results.success++;
                    results.outputFiles.push(finalOutputPath);
                    addLog(`   ✅ ${path.basename(finalOutputPath)}`, 'success');
                }
                
            } catch (error) {
                results.failed++;
                results.errors.push(error.message);
                addLog(`   ❌ ${path.basename(file.filePath || file.path)}: ${error.message}`, 'error');
            }
        }
        
        addLog(`✅ Convert animation to videocomplete: successfully${results.success}, failed${results.failed}`, results.failed > 0 ? 'warning' : 'success');
        
        // 🔥 显示Eagle通知（成功/失败/部分失败）
        if (typeof showEagleNotification === 'function') {
            if (results.success > 0 && results.failed === 0) {
                // 全部成功
                await showEagleNotification('✅ 动图转视频完成', `成功转换 ${results.success} 个动图`, 'success', 3000);
            } else if (results.success > 0 && results.failed > 0) {
                // 部分成功
                await showEagleNotification('⚠️ 动图转视频完成（部分失败）', `成功: ${results.success} 个，失败: ${results.failed} 个`, 'warning', 4000);
            } else if (results.success === 0 && results.failed > 0) {
                // 全部失败
                await showEagleNotification('❌ 动图转视频失败', `所有动图转换失败，请检查日志`, 'error', 4000);
            }
        }
        
        return results;
    }
    
    /**
