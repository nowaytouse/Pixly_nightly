    /**
     * 🎬 视频转视频（Video→Video）
     * 用于重编码/优化现有视频文件
     */
    async function convertVideoToVideo(file, config) {
        const Logger = window.PIXLY?.Logger || console;
        
        Logger.info(`[PIXLY Video] 🎬 Video→Video conversion: ${file.name}${file.ext}`);
        
        try {
            // 准备选项对象
            const options = {
                codec: config.encoder || 'h265',
                quality: config.crf || 23,
                preset: config.preset || 'medium',
                container: config.container || 'mp4',
                audioCodec: 'aac',
                audioBitrate: '128k',
                enableVMAF: config.enableVMAF || false,
                minVMAFScore: 85
            };
            
            // 如果是智能模式，使用AI预测参数
            if (config.smartMode && window.PIXLY?.VideoAIClient) {
                try {
                    Logger.info('[PIXLY Video] 🤖 Using AI prediction for video params...');
                    
                    const prediction = await window.PIXLY.VideoAIClient.predictVideoParams(
                        file.filePath,
                        'balanced',
                        {
                            use_advanced_ai: config.enableAdvancedFeatures || false,
                            enable_transformer: config.enableTransformer || false,
                            enable_vmaf: config.enableVMAF || false
                        }
                    );
                    
                    if (prediction && prediction.success && prediction.params) {
                        Logger.info(`[PIXLY Video] ✅ AI predicted: encoder=${prediction.params.encoder}, crf=${prediction.params.crf}`);
                        options.codec = prediction.params.encoder || options.codec;
                        options.quality = prediction.params.crf || options.quality;
                        options.preset = prediction.params.preset || options.preset;
                    }
                } catch (aiError) {
                    Logger.warn(`[PIXLY Video] ⚠️ AI prediction failed, using default params: ${aiError.message}`);
                }
            }
            
            // 调用optimizeVideo函数
            const result = await optimizeVideo([file], options);
            
            return {
                success: result.success > 0,
                outputPath: result.outputFiles[0] || null,
                error: result.errors[0] || null
            };
            
        } catch (error) {
            Logger.error(`[PIXLY Video] ❌ Video conversion failed: ${error.message}`);
            return {
                success: false,
                error: error.message
            };
        }
    }

