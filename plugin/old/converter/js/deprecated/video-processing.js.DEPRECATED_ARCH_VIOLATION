    /**
     * 🔧 构建FFmpegparameter
     */
    function buildFFmpegArgs(inputPath, outputPath, options) {
        const {
            codec,
            quality,
            preset,
            fps,
            audioCodec = 'aac',
            audioBitrate = '128k',
            proResProfile = 'standard'
        } = options;
        
        // 🎬 检测输入是否为动图（GIF/WebP/APNG没有音频）
        const path = require('path');
        const inputExt = path.extname(inputPath).toLowerCase();
        const isAnimatedImage = ['.gif', '.webp', '.apng'].includes(inputExt);
        
        let args = [];
        
        // 输入文件
        args.push('-i', inputPath);
        
        // 🎬 添加scale滤镜（确保宽高是偶数，H.264/H.265要求）
        // trunc(iw/2)*2: 将宽度调整为最接近的偶数
        // trunc(ih/2)*2: 将高度调整为最接近的偶数
        args.push('-vf', 'scale=trunc(iw/2)*2:trunc(ih/2)*2');
        
        // 🔥 根据编码器构建parameter
        switch (codec) {
            case 'h264':
                args.push(
                    '-c:v', 'libx264',
                    '-preset', preset,
                    '-crf', quality.toString(),
                    '-pix_fmt', 'yuv420p'
                );
                if (fps) args.push('-r', fps.toString());
                
                // ✅ 只有非动图才添加音频参数
                if (!isAnimatedImage) {
                    args.push(
                        '-c:a', audioCodec,
                        '-b:a', audioBitrate
                    );
                }
                args.push('-movflags', '+faststart');
                break;
            
            case 'h265':
            case 'hevc':
                args.push(
                    '-c:v', 'libx265',
                    '-preset', preset,
                    '-crf', quality.toString(),
                    '-pix_fmt', 'yuv420p',  // ✅ 确保兼容性
                    '-tag:v', 'hvc1'
                );
                if (fps) args.push('-r', fps.toString());
                
                // ✅ 只有非动图才添加音频参数
                if (!isAnimatedImage) {
                    args.push(
                        '-c:a', audioCodec,
                        '-b:a', audioBitrate
                    );
                }
                args.push('-movflags', '+faststart');
                break;
            
            case 'av1':
                args.push(
                    '-c:v', 'libaom-av1',
                    '-crf', quality.toString(),
                    '-cpu-used', '4',
                    '-row-mt', '1',
                    '-tiles', '2x2'
                );
                if (fps) args.push('-r', fps.toString());
                
                // ✅ 只有非动图才添加音频参数
                if (!isAnimatedImage) {
                    args.push(
                        '-c:a', audioCodec,
                        '-b:a', audioBitrate
                    );
                }
                args.push('-movflags', '+faststart');
                break;
            
            case 'h266':
            case 'vvc':
                // H.266/VVC needFFmpeg 8.0+andlibvvenc
                args.push(
                    '-c:v', 'libvvenc',
                    '-qp', quality.toString(),
                    '-preset', preset === 'fast' ? 'faster' : preset
                );
                if (fps) args.push('-r', fps.toString());
                
                // ✅ 只有非动图才添加音频参数
                if (!isAnimatedImage) {
                    args.push(
                        '-c:a', audioCodec,
                        '-b:a', audioBitrate
                    );
                }
                args.push('-movflags', '+faststart');
                addLog(`   ⚠️ H.266needFFmpeg 8.0+andlibvvenc支持`, 'warning');
                break;
            
            case 'prores':
                // ProRes专业编码
                const profileMap = {
                    'proxy': '0',
                    'lt': '1',
                    'standard': '2',
                    'hq': '3',
                    '4444': '4',
                    '4444xq': '5'
                };
                args.push(
                    '-c:v', 'prores_ks',
                    '-profile:v', profileMap[proResProfile] || '2',
                    '-c:a', 'pcm_s16le', // ProRes用无损音频
                    '-movflags', '+faststart'
                );
                break;
            
            default:
                throw new Error(`不支持编码器: ${codec}`);
        }
        
        args.push('-y', outputPath);
        
        // 📊 Debug: 输出完整FFmpeg命令
        console.log(`[PIXLY Video] 📋 FFmpeg args:`, args.join(' '));
        
        return args;
    }
    
    /**
     * 🔧 获取 FFmpeg 完整路径（解决环境变量问题）
     */
    function getFFmpegPath() {
        const fs = require('fs');
        const commonPaths = [
            '/opt/homebrew/bin/ffmpeg',    // Homebrew (Apple Silicon)
            '/usr/local/bin/ffmpeg',       // Homebrew (Intel)
            '/opt/local/bin/ffmpeg',       // MacPorts
            '/usr/bin/ffmpeg'              // 系统默认
        ];
        
        for (const path of commonPaths) {
            if (fs.existsSync(path)) {
                return path;
            }
        }
        
        // 如果都找不到，返回'ffmpeg'让系统PATH处理
        return 'ffmpeg';
    }
    
    /**
     * 🎬 执linesFFmpeg命令
     */
    function executeFFmpeg(args) {
        return new Promise((resolve, reject) => {
            const ffmpegPath = getFFmpegPath();
            console.log(`[PIXLY Video] 🎬 Using ffmpeg: ${ffmpegPath}`);
            console.log(`[PIXLY Video] 🔧 Command: ${ffmpegPath} ${args.join(' ')}`);
            
            const process = spawn(ffmpegPath, args);
            let stdout = '';
            let stderr = '';
            
            // ✅ 处理stdout（防止缓冲区满导致挂起）
            process.stdout.on('data', (data) => {
                stdout += data.toString();
            });
            
            // ✅ 处理stderr（FFmpeg输出主要在stderr）
            process.stderr.on('data', (data) => {
                stderr += data.toString();
            });
            
            // ✅ 进程错误处理
            process.on('error', (error) => {
                clearTimeout(timeout);
                console.error(`[PIXLY Video] ❌ FFmpeg process error:`, error);
                reject(new Error(`FFmpeg error: ${error.message}`));
            });
            
            // ✅ 超时保护（60秒超时，优雅关闭）
            let timedOut = false;
            const timeout = setTimeout(() => {
                timedOut = true;
                console.warn(`[PIXLY Video] ⏱️ FFmpeg timeout, attempting graceful shutdown (SIGTERM)`);
                process.kill('SIGTERM');
                
                // 如果5秒后还没结束，强制kill
                setTimeout(() => {
                    if (!process.killed) {
                        console.error(`[PIXLY Video] ⏱️ FFmpeg still running, force killing (SIGKILL)`);
                process.kill('SIGKILL');
                    }
                }, 5000);
            }, 60000);
            
            // ✅ 成功或失败时清除超时
            process.on('close', (code) => {
                clearTimeout(timeout);
                
                if (timedOut) {
                    reject(new Error('FFmpeg timeout after 60 seconds'));
                } else if (code === 0) {
                    console.log(`[PIXLY Video] ✅ FFmpeg completed successfully`);
                    resolve();
                } else {
                    const errorMsg = stderr.slice(-500);
                    console.error(`[PIXLY Video] ❌ FFmpeg failed (code ${code}):`, errorMsg);
                    reject(new Error(`FFmpeg failed (code ${code}): ${errorMsg}`));
                }
            });
        });
    }
    
    /**
     * ⏱️ 格式化视频时长
     */
    function formatVideoTimecode(seconds) {
        const h = Math.floor(seconds / 3600);
        const m = Math.floor((seconds % 3600) / 60);
        const s = Math.floor(seconds % 60);
        
        if (h > 0) {
            return `${h}:${m.toString().padStart(2, '0')}:${s.toString().padStart(2, '0')}`;
        }
        return `${m}:${s.toString().padStart(2, '0')}`;
    }
    
