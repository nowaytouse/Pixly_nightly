/**
 * PIXLY Convertvalidatemodule
 * 依赖: PIXLY命名空间, child_process
 */
(function(window) {
    'use strict';
    
    window.PIXLY = window.PIXLY || {};
    
    /**
     * validate器
     */
    const Validator = {
        
        /**
         * validate输出file
         */
        validateOutput: async function(inputPath, outputPath, options = {}) {
            const fs = require('fs');
            const path = require('path');
            
            try {
                // 1. Checkfileis否exists
                if (!fs.existsSync(outputPath)) {
                    return {
                        valid: false,
                        error: '输出file不exists'
                    };
                }
                
                // 2. Checkfile大小
                const stats = fs.statSync(outputPath);
                if (stats.size === 0) {
                    return {
                        valid: false,
                        error: '输出fileis empty'
                    };
                }
                
                // 3. Checkfile可读性
                try {
                    fs.accessSync(outputPath, fs.constants.R_OK);
                } catch (e) {
                    return {
                        valid: false,
                        error: '输出file不可读'
                    };
                }
                
                // 4. Check格式valid性（可选）
                if (options.checkFormat) {
                    const isValid = await this.checkImageFormat(outputPath);
                    if (!isValid) {
                        return {
                            valid: false,
                            error: '输出file格式invalid'
                        };
                    }
                }
                
                // 5. calculation质量指标（如果启用）
                let quality = null;
                if (options.checkQuality && inputPath) {
                    quality = await this.calculateSSIM(inputPath, outputPath);
                }
                
                return {
                    valid: true,
                    size: stats.size,
                    quality: quality,
                    path: outputPath
                };
                
            } catch (error) {
                return {
                    valid: false,
                    error: error.message
                };
            }
        },
        
        /**
         * Check图像格式valid性
         */
        checkImageFormat: async function(imagePath) {
            try {
                const { exec } = require('child_process');
                const { promisify } = require('util');
                const execAsync = promisify(exec);
                
                // 使用 ffprobe Check图像
                const command = `ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of default=noprint_wrappers=1:nokey=1 "${imagePath}"`;
                const { stdout } = await execAsync(command);
                
                return stdout.trim().length > 0;
            } catch (error) {
 console.error('[PIXLY Validation] format checkfailed:', error);
                return false;
            }
        },
        
        /**
         * calculation SSIM (结构相似性指数)
         */
        calculateSSIM: async function(inputPath, outputPath) {
            try {
                const { exec } = require('child_process');
                const { promisify } = require('util');
                const execAsync = promisify(exec);
                
                // 使用 ffmpeg calculation SSIM
                const command = `ffmpeg -i "${inputPath}" -i "${outputPath}" -lavfi ssim -f null -`;
                const { stderr } = await execAsync(command);
                
                // 解析 SSIM 值
                const match = stderr.match(/SSIM\s+All:\s+([\d.]+)/);
                if (match && match[1]) {
                    return parseFloat(match[1]);
                }
                
                return null;
            } catch (error) {
 console.error('[PIXLY Validation] SSIM calculationfailed:', error);
                return null;
            }
        },
        
        /**
         * calculation PSNR (峰值信噪比)
         */
        calculatePSNR: async function(inputPath, outputPath) {
            try {
                const { exec } = require('child_process');
                const { promisify } = require('util');
                const execAsync = promisify(exec);
                
                // 使用 ffmpeg calculation PSNR
                const command = `ffmpeg -i "${inputPath}" -i "${outputPath}" -lavfi psnr -f null -`;
                const { stderr } = await execAsync(command);
                
                // 解析 PSNR 值
                const match = stderr.match(/PSNR\s+y:\s+([\d.]+)/);
                if (match && match[1]) {
                    return parseFloat(match[1]);
                }
                
                return null;
            } catch (error) {
 console.error('[PIXLY Validation] PSNR calculationfailed:', error);
                return null;
            }
        },
        
        /**
         * validatemetadatais否保留
         */
        validateMetadata: async function(inputPath, outputPath) {
            try {
                const { exec } = require('child_process');
                const { promisify } = require('util');
                const execAsync = promisify(exec);
                
                // 获取输入filemetadata
                const inputMeta = await execAsync(`exiftool -j "${inputPath}"`);
                const inputData = JSON.parse(inputMeta.stdout)[0];
                
                // 获取输出filemetadata
                const outputMeta = await execAsync(`exiftool -j "${outputPath}"`);
                const outputData = JSON.parse(outputMeta.stdout)[0];
                
                // Check关键metadata
                const keyFields = ['Make', 'Model', 'DateTimeOriginal', 'GPSLatitude', 'GPSLongitude'];
                const preserved = {};
                
                for (const field of keyFields) {
                    if (inputData[field]) {
                        preserved[field] = inputData[field] === outputData[field];
                    }
                }
                
                return {
                    hasMetadata: Object.keys(preserved).length > 0,
                    preserved: preserved
                };
            } catch (error) {
 console.error('[PIXLY Validation] Metadata validationfailed:', error);
                return { hasMetadata: false, preserved: {} };
            }
        },
        
        /**
         * validate动图帧数
         */
        validateAnimationFrames: async function(inputPath, outputPath) {
            try {
                const { exec } = require('child_process');
                const { promisify } = require('util');
                const execAsync = promisify(exec);
                
                // 获取输入帧数
                const inputCmd = `ffprobe -v error -select_streams v:0 -count_frames -show_entries stream=nb_read_frames -of csv=p=0 "${inputPath}"`;
                const { stdout: inputFrames } = await execAsync(inputCmd);
                
                // 获取输出帧数
                const outputCmd = `ffprobe -v error -select_streams v:0 -count_frames -show_entries stream=nb_read_frames -of csv=p=0 "${outputPath}"`;
                const { stdout: outputFrames } = await execAsync(outputCmd);
                
                const input = parseInt(inputFrames.trim());
                const output = parseInt(outputFrames.trim());
                
                return {
                    inputFrames: input,
                    outputFrames: output,
                    preserved: input === output
                };
            } catch (error) {
 console.error('[PIXLY Validation] Animation frame validationfailed:', error);
                return { inputFrames: 0, outputFrames: 0, preserved: false };
            }
        },
        
        /**
         * validate透明通道
         */
        validateAlphaChannel: async function(inputPath, outputPath) {
            try {
                const { exec } = require('child_process');
                const { promisify } = require('util');
                const execAsync = promisify(exec);
                
                // Check输入is否有 alpha 通道
                const inputCmd = `ffprobe -v error -select_streams v:0 -show_entries stream=pix_fmt -of default=noprint_wrappers=1:nokey=1 "${inputPath}"`;
                const { stdout: inputPixFmt } = await execAsync(inputCmd);
                
                // Check输出is否有 alpha 通道
                const outputCmd = `ffprobe -v error -select_streams v:0 -show_entries stream=pix_fmt -of default=noprint_wrappers=1:nokey=1 "${outputPath}"`;
                const { stdout: outputPixFmt } = await execAsync(outputCmd);
                
                const inputHasAlpha = inputPixFmt.toLowerCase().includes('a');
                const outputHasAlpha = outputPixFmt.toLowerCase().includes('a');
                
                return {
                    inputHasAlpha: inputHasAlpha,
                    outputHasAlpha: outputHasAlpha,
                    preserved: !inputHasAlpha || outputHasAlpha
                };
            } catch (error) {
 console.error('[PIXLY Validation] Alpha Channel validationfailed:', error);
                return { inputHasAlpha: false, outputHasAlpha: false, preserved: true };
            }
        },
        
        /**
         * 综合validate
         */
        validateAll: async function(inputPath, outputPath, options = {}) {
            const results = {
                basic: await this.validateOutput(inputPath, outputPath, options),
                metadata: null,
                frames: null,
                alpha: null
            };
            
            // 根据options执lines额外validate
            if (options.checkMetadata) {
                results.metadata = await this.validateMetadata(inputPath, outputPath);
            }
            
            if (options.checkFrames) {
                results.frames = await this.validateAnimationFrames(inputPath, outputPath);
            }
            
            if (options.checkAlpha) {
                results.alpha = await this.validateAlphaChannel(inputPath, outputPath);
            }
            
            return results;
        }
    };
    
    // 暴露to全局
    PIXLY.Validator = Validator;
    
    // 向后兼容
    window.validateOutput = function(inputPath, outputPath, options) {
        return Validator.validateOutput(inputPath, outputPath, options);
    };
    
    window.calculateSSIM = function(inputPath, outputPath) {
        return Validator.calculateSSIM(inputPath, outputPath);
    };
    
    window.calculatePSNR = function(inputPath, outputPath) {
        return Validator.calculatePSNR(inputPath, outputPath);
    };
    
 console.log('[PIXLY Validation] Validation module loaded');
    
})(window);
