{
  "$schema": "./config.schema.json",
  "version": "2.0.0",
  "services": {
    "ai": {
      "host": "localhost",
      "port": 50052,
      "protocol": "http",
      "timeout": 30000,
      "enabled": true
    },
    "conversion": {
      "host": "localhost",
      "port": 8080,
      "protocol": "http",
      "timeout": 120000,
      "enabled": false,
      "deprecated": true,
      "note": "建议使用 rustCLI 代替"
    },
    "rustCLI": {
      "enabled": true,
      "cliPath": "pixly-rust",
      "timeout": 300000
    }
  },
  "environment": {
    "allowEnvOverride": true,
    "envPrefix": "PIXLY_"
  },
  "logging": {
    "level": "info",
    "enableDebug": false
  }
}
