{
  "version": "2.0.0",
  "description": "针对各格式特性优化的训练种子库 - 让AI深度理解每种格式的最佳特点",
  "created": "2025-11-03",
  "updated": "2025-11-03",
  
  "format_characteristics": {
    "jxl": {
      "name": "JPEG XL",
      "strengths": [
        "极致压缩率（比JPEG小30-60%）",
        "完美无损JPEG转码（lossless_jpeg=1）",
        "支持真正的数学无损（distance=0）",
        "优秀的动画支持（比GIF小90%+）",
        "高级功能：渐进式加载、ROI编码",
        "宽色域支持（10-bit+）"
      ],
      "best_for": [
        "照片压缩（替代JPEG）",
        "动画/GIF替代",
        "无损归档",
        "需要极致压缩的场景"
      ],
      "weakness": [
        "浏览器支持有限（需polyfill）",
        "编码速度较慢"
      ]
    },
    "avif": {
      "name": "AV1 Image File Format",
      "strengths": [
        "极佳的有损压缩（比JPEG小50%+）",
        "优秀的细节保留能力",
        "HDR和宽色域支持",
        "良好的浏览器支持",
        "适合Web使用"
      ],
      "best_for": [
        "Web图片（现代浏览器）",
        "照片质量优先",
        "HDR内容",
        "社交媒体图片"
      ],
      "weakness": [
        "编码极慢（speed=0-13）",
        "无损模式效率不高",
        "动画支持有限"
      ]
    },
    "webp": {
      "name": "WebP",
      "strengths": [
        "广泛的浏览器支持",
        "编码速度快",
        "有损和无损双模式",
        "透明度支持好",
        "动画支持（但效率一般）"
      ],
      "best_for": [
        "Web图片（兼容性优先）",
        "需要快速编码",
        "透明PNG替代",
        "简单动画"
      ],
      "weakness": [
        "压缩率不如JXL/AVIF",
        "无损模式效率一般"
      ]
    },
    "heic": {
      "name": "HEIF/HEIC",
      "strengths": [
        "iOS/macOS原生支持",
        "优秀的压缩率",
        "支持元数据丰富",
        "HDR支持"
      ],
      "best_for": [
        "Apple生态",
        "照片归档",
        "移动设备"
      ],
      "weakness": [
        "Windows/Linux支持差",
        "Web不支持",
        "专利问题"
      ]
    }
  },

