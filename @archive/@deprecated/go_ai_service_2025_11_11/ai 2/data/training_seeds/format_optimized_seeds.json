  "training_guidelines": {
    "format_selection_priority": [
      "1. 动画内容 → JXL（压缩率最高）",
      "2. 需要极致压缩 → JXL（距离调节灵活）",
      "3. Web现代浏览器 → AVIF（质量/体积最佳）",
      "4. Web兼容性优先 → WebP（支持最广）",
      "5. Apple生态 → HEIC（原生支持）",
      "6. 无损归档 → JXL modular模式（最高效）",
      "7. 透明图片 → WebP无损（快速+兼容）"
    ],
    "quality_tuning_rules": {
      "jxl": {
        "distance_quality_mapping": {
          "0.0": "数学无损，SSIM=1.0",
          "0.1-0.5": "视觉无损，SSIM>0.98",
          "0.6-1.0": "高质量，SSIM>0.96",
          "1.1-2.0": "平衡，SSIM>0.93",
          "2.1-4.0": "Web优化，SSIM>0.90"
        },
        "effort_speed_tradeoff": "effort↑ = 体积↓ 10-15% | 时间↑ 2-3x"
      },
      "avif": {
        "quality_range": {
          "60-65": "顶级质量，接近原图",
          "55-60": "高质量，肉眼难辨",
          "50-55": "优秀质量，Web标准",
          "45-50": "良好质量，移动优化",
          "40-45": "可接受，体积优先"
        },
        "speed_impact": "speed 0-4 = 慢但质量最佳 | speed 6-10 = 快速但质量略降"
      },
      "webp": {
        "quality_guidance": {
          "90-100": "高质量，接近PNG",
          "80-90": "平衡，日常使用",
          "70-80": "Web优化",
          "60-70": "移动端"
        },
        "method_choice": "method 6 = 最佳质量 | method 4 = 平衡 | method 0-2 = 快速"
      }
    },
    "reward_calculation": {
      "formula": "R = 0.5*SSIM + 0.3*(1-compression_ratio) + 0.2*speed_score",
      "ssim_threshold": {
        "excellent": ">0.97",
        "good": "0.95-0.97",
        "acceptable": "0.92-0.95",
        "poor": "<0.92"
      },
      "compression_target": {
        "jxl": "0.30-0.50（极致）",
        "avif": "0.35-0.55（优秀）",
        "webp": "0.40-0.60（良好）"
      }
    }
  },

  "ppo_training_config": {
    "state_features": [
      "image_width",
      "image_height",
      "pixel_count",
      "aspect_ratio",
      "has_alpha",
      "image_type",
      "complexity_score",
      "edge_density",
      "texture_level",
      "color_variance",
      "target_format",
      "optimize_mode"
    ],
    "action_space": {
      "quality": {"min": 40, "max": 100, "step": 1},
      "distance": {"min": 0.0, "max": 4.0, "step": 0.1},
      "effort": {"min": 3, "max": 9, "step": 1},
      "speed": {"min": 1, "max": 10, "step": 1}
    },
    "training_hyperparameters": {
      "episodes": 100,
      "batch_size": 32,
      "learning_rate": 0.0003,
      "gamma": 0.99,
      "clip_epsilon": 0.2,
      "value_coefficient": 0.5,
      "entropy_coefficient": 0.01,
      "max_grad_norm": 0.5,
      "ppo_epochs": 10,
      "min_observations": 50
    }
  },

  "notes": [
    "本种子库基于大量实测和各格式官方文档优化",
    "每个种子都针对特定场景和格式特性调优",
    "PPO训练将基于这些种子作为初始策略",
    "训练后模型将学会根据图像特征自动选择最佳参数",
    "建议收集多样化的图像类型以获得最佳训练效果"
  ]
}
