// TestValidateImageInfo 测试图像信息验证
func TestValidateImageInfo(t *testing.T) {
	tests := []struct {
		name    string
		img     *pb.ImageInfo
		wantErr bool
	}{
		{
			name: "valid image info",
			img: &pb.ImageInfo{
				FilePath: "/path/to/image.jpg",
				Width:    1920,
				Height:   1080,
				Size:     1024000,
				Format:   "jpg",
			},
			wantErr: false,
		},
		{
			name: "nil image info",
			img:  nil,
			wantErr: true,
		},
		{
			name: "empty file path",
			img: &pb.ImageInfo{
				FilePath: "",
				Width:    1920,
				Height:   1080,
				Size:     1024000,
				Format:   "jpg",
			},
			wantErr: true,
		},
		{
			name: "invalid width - zero",
			img: &pb.ImageInfo{
				FilePath: "/path/to/image.jpg",
				Width:    0,
				Height:   1080,
				Size:     1024000,
				Format:   "jpg",
			},
			wantErr: true,
		},
		{
			name: "invalid width - negative",
			img: &pb.ImageInfo{
				FilePath: "/path/to/image.jpg",
				Width:    -100,
				Height:   1080,
				Size:     1024000,
				Format:   "jpg",
			},
			wantErr: true,
		},
		{
			name: "invalid width - too large",
			img: &pb.ImageInfo{
				FilePath: "/path/to/image.jpg",
				Width:    100000,
				Height:   1080,
				Size:     1024000,
				Format:   "jpg",
			},
			wantErr: true,
		},
		{
			name: "invalid height - zero",
			img: &pb.ImageInfo{
				FilePath: "/path/to/image.jpg",
				Width:    1920,
				Height:   0,
				Size:     1024000,
				Format:   "jpg",
			},
			wantErr: true,
		},
		{
			name: "invalid size - zero",
			img: &pb.ImageInfo{
				FilePath: "/path/to/image.jpg",
				Width:    1920,
				Height:   1080,
				Size:     0,
				Format:   "jpg",
			},
			wantErr: true,
		},
		{
			name: "invalid size - negative",
			img: &pb.ImageInfo{
				FilePath: "/path/to/image.jpg",
				Width:    1920,
				Height:   1080,
				Size:     -1000,
				Format:   "jpg",
			},
			wantErr: true,
		},
		{
			name: "invalid format - empty",
			img: &pb.ImageInfo{
				FilePath: "/path/to/image.jpg",
				Width:    1920,
				Height:   1080,
				Size:     1024000,
				Format:   "",
			},
			wantErr: true,
		},
		{
			name: "invalid format - unsupported",
			img: &pb.ImageInfo{
				FilePath: "/path/to/image.jpg",
				Width:    1920,
				Height:   1080,
				Size:     1024000,
				Format:   "xyz",
			},
			wantErr: true,
		},
		{
			name: "image too large - exceeds max pixels",
			img: &pb.ImageInfo{
				FilePath: "/path/to/image.jpg",
				Width:    50000,
				Height:   50000, // 25亿像素，超过10亿限制
				Size:     1024000,
				Format:   "jpg",
			},
			wantErr: true,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			err := validateImageInfo(tt.img)
			if (err != nil) != tt.wantErr {
				t.Errorf("validateImageInfo() error = %v, wantErr %v", err, tt.wantErr)
			}
		})
	}
}

