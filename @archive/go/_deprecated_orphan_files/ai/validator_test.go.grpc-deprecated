// TestValidatePredictRequest 测试完整预测请求验证
func TestValidatePredictRequest(t *testing.T) {
	validImage := &pb.ImageInfo{
		FilePath: "/path/to/image.jpg",
		Width:    1920,
		Height:   1080,
		Size:     1024000,
		Format:   "jpg",
	}

	tests := []struct {
		name    string
		req     *pb.PredictRequest
		wantErr bool
	}{
		{
			name: "valid request",
			req: &pb.PredictRequest{
				Mode:  pb.PredictRequest_ADVANCED,
				Image: validImage,
				Tool:  "cjxl",
				Options: &pb.PredictOptions{
					SsimThreshold: 0.95,
				},
			},
			wantErr: false,
		},
		{
			name:    "nil request",
			req:     nil,
			wantErr: true,
		},
		{
			name: "invalid mode",
			req: &pb.PredictRequest{
				Mode:  pb.PredictRequest_Mode(999),
				Image: validImage,
				Tool:  "cjxl",
			},
			wantErr: true,
		},
		{
			name: "nil image",
			req: &pb.PredictRequest{
				Mode:  pb.PredictRequest_BASIC,
				Image: nil,
				Tool:  "cjxl",
			},
			wantErr: true,
		},
		{
			name: "invalid tool",
			req: &pb.PredictRequest{
				Mode:  pb.PredictRequest_BASIC,
				Image: validImage,
				Tool:  "invalid",
			},
			wantErr: true,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			err := ValidatePredictRequest(tt.req)
			if (err != nil) != tt.wantErr {
				t.Errorf("ValidatePredictRequest() error = %v, wantErr %v", err, tt.wantErr)
			}
			
			// 验证错误是gRPC status错误
			if err != nil {
				if _, ok := status.FromError(err); !ok {
					t.Errorf("Expected gRPC status error, got: %T", err)
				}
			}
		})
	}
}

// TestValidatePredictResponse 测试响应验证
func TestValidatePredictResponse(t *testing.T) {
	tests := []struct {
		name    string
		resp    *pb.PredictResponse
		tool    string
		wantErr bool
	}{
		{
			name: "valid response",
			resp: &pb.PredictResponse{
				Confidence:       0.85,
				PredictionTimeMs: 150.0,
				Params: &pb.ToolParams{
					CjxlQuality: 90,
					CjxlEffort:  7,
				},
			},
			tool:    "cjxl",
			wantErr: false,
		},
		{
			name:    "nil response",
			resp:    nil,
			tool:    "cjxl",
			wantErr: true,
		},
		{
			name: "invalid confidence - negative",
			resp: &pb.PredictResponse{
				Confidence: -0.1,
			},
			tool:    "cjxl",
			wantErr: true,
		},
		{
			name: "invalid confidence - greater than 1",
			resp: &pb.PredictResponse{
				Confidence: 1.5,
			},
			tool:    "cjxl",
			wantErr: true,
		},
		{
			name: "invalid prediction time",
			resp: &pb.PredictResponse{
				Confidence:       0.85,
				PredictionTimeMs: -10.0,
			},
			tool:    "cjxl",
			wantErr: true,
		},
	}

	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			err := ValidatePredictResponse(tt.resp, tt.tool)
			if (err != nil) != tt.wantErr {
				t.Errorf("ValidatePredictResponse() error = %v, wantErr %v", err, tt.wantErr)
			}
		})
	}
}

