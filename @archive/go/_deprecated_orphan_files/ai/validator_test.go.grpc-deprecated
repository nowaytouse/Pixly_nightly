	tests := []struct {
		name    string
		opts    *pb.PredictOptions
		wantErr bool
	}{
		{
			name: "valid options",
			opts: &pb.PredictOptions{
				TargetFormat:   "avif",
				SsimThreshold:  0.95,
				MaxIterations:  10,
				EnableBayesian: true,
			},
			wantErr: false,
		},
		{
			name:    "nil options",
			opts:    nil,
			wantErr: false, // nil is allowed
