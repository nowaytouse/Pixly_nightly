		{"valid - avifenc", "avifenc", false},
		{"valid - cwebp", "cwebp", false},
		{"valid - ffmpeg", "ffmpeg", false},
		{"valid - magick", "magick", false},
		{"valid - uppercase", "CJXL", false},
