			wantErr: true,
		},
		{
			name: "invalid SSIM - greater than 1",
			opts: &pb.PredictOptions{
				SsimThreshold: 1.5,
			},
			wantErr: true,
		},
		{
			name: "invalid iterations - negative",
			opts: &pb.PredictOptions{
				MaxIterations: -1,
			},
			wantErr: true,
		},
		{
			name: "invalid iterations - too large",
			opts: &pb.PredictOptions{
				MaxIterations: 200,
			},
			wantErr: true,
		},
		{
			name: "invalid target format",
			opts: &pb.PredictOptions{
				TargetFormat: "xyz",
			},
			wantErr: true,
		},
	}

	for _, tt := range tests {
