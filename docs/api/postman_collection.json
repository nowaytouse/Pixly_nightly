{
  "info": {
    "name": "Pixly AI Service API",
    "description": "AI驱动的图像和视频参数预测服务",
    "version": "3.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Prediction",
      "item": [
        {
          "name": "AI参数预测",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/predict",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "predict"
              ]
            },
            "description": "基于图像特征预测最佳压缩参数",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"image_path\": \"/path/to/image.jpg\",\n  \"tool\": \"jxl\",\n  \"target_quality\": 85,\n  \"optimize_mode\": \"balanced\"\n}"
            }
          }
        },
        {
          "name": "视频AI参数预测",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/predict/video",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "predict",
                "video"
              ]
            },
            "description": "基于视频特征预测最佳压缩参数",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"video_path\": \"/path/to/video.mp4\",\n  \"target_codec\": \"h265\",\n  \"target_crf\": 23,\n  \"preset\": \"medium\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "System",
      "item": [
        {
          "name": "健康检查",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "health"
              ]
            },
            "description": "获取服务健康状态"
          }
        },
        {
          "name": "获取服务能力",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/capabilities",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "capabilities"
              ]
            },
            "description": "获取AI服务支持的功能和格式列表"
          }
        }
      ]
    },
    {
      "name": "Models",
      "item": [
        {
          "name": "获取模型列表",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/models",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "models"
              ]
            },
            "description": "获取所有可用的AI模型版本"
          }
        },
        {
          "name": "注册新模型",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/models/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "models",
                "register"
              ]
            },
            "description": "注册新的AI模型版本到系统",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"lightgbm\",\n  \"version\": \"v2.0.0\",\n  \"model_path\": \"/models/lightgbm_v2.pth\",\n  \"description\": \"\\u6539\\u8fdb\\u7684LightGBM\\u6a21\\u578b\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Training",
      "item": [
        {
          "name": "启动训练队列",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/training/start",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "training",
                "start"
              ]
            },
            "description": "启动自动化模型训练队列"
          }
        },
        {
          "name": "获取训练状态",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/training/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "training",
                "status"
              ]
            },
            "description": "获取当前模型训练队列的状态"
          }
        }
      ]
    },
    {
      "name": "Feedback",
      "item": [
        {
          "name": "记录用户反馈",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/feedback/record",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "feedback",
                "record"
              ]
            },
            "description": "记录用户对AI预测结果的反馈",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"prediction_id\": \"pred_123456\",\n  \"user_rating\": 4,\n  \"actual_quality\": 87,\n  \"comments\": \"\\u9884\\u6d4b\\u5f88\\u51c6\\u786e\"\n}"
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "api_key",
      "value": "your_api_key_here"
    }
  ]
}