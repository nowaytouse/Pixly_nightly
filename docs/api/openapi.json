{
  "openapi": "3.0.0",
  "info": {
    "title": "Pixly AI Service API",
    "description": "AI驱动的图像和视频参数预测服务",
    "version": "3.0.0",
    "contact": {
      "name": "Pixly Team",
      "email": "team@pixly.ai"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Development Server"
    },
    {
      "url": "https://api.pixly.ai",
      "description": "Production Server"
    }
  ],
  "paths": {
    "/api/v1/predict": {
      "post": {
        "summary": "AI参数预测",
        "description": "基于图像特征预测最佳压缩参数",
        "tags": [
          "prediction",
          "ai"
        ],
        "parameters": [
          {
            "name": "image_path",
            "in": "query",
            "description": "图像文件路径",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "/path/to/image.jpg"
          },
          {
            "name": "tool",
            "in": "query",
            "description": "目标压缩工具",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "jxl",
                "avif",
                "webp"
              ]
            },
            "example": "jxl"
          },
          {
            "name": "target_quality",
            "in": "query",
            "description": "目标质量",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "example": 85
          },
          {
            "name": "optimize_mode",
            "in": "query",
            "description": "优化模式",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "size",
                "balanced",
                "quality",
                "universal"
              ]
            },
            "example": "balanced"
          }
        ],
        "responses": {
          "200": {
            "description": "预测成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": true,
                  "params": {
                    "quality": 85,
                    "effort": 7,
                    "distance": 1.0
                  },
                  "confidence": 0.85,
                  "model_used": "lightgbm",
                  "inference_time_ms": 120.5
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误"
          },
          "500": {
            "description": "服务器内部错误"
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "summary": "健康检查",
        "description": "获取服务健康状态",
        "tags": [
          "system"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "服务健康",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "status": "healthy",
                  "version": "3.0.0",
                  "ready": true,
                  "timestamp": "2025-11-12T17:20:00Z"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models": {
      "get": {
        "summary": "获取模型列表",
        "description": "获取所有可用的AI模型版本",
        "tags": [
          "models"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "模型列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "models": {
                    "lightgbm": [
                      {
                        "version": "v1.0.0",
                        "status": "active"
                      }
                    ],
                    "ppo": [
                      {
                        "version": "v1.0.0",
                        "status": "active"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/training/start": {
      "post": {
        "summary": "启动训练队列",
        "description": "启动自动化模型训练队列",
        "tags": [
          "training"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "训练启动成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": true,
                  "message": "训练队列已启动"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/predict/video": {
      "post": {
        "summary": "视频AI参数预测",
        "description": "基于视频特征预测最佳压缩参数",
        "tags": [
          "prediction",
          "video"
        ],
        "parameters": [
          {
            "name": "video_path",
            "in": "query",
            "description": "视频文件路径",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "/path/to/video.mp4"
          },
          {
            "name": "target_codec",
            "in": "query",
            "description": "目标编解码器",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "h264",
                "h265",
                "av1"
              ]
            },
            "example": "h265"
          },
          {
            "name": "target_crf",
            "in": "query",
            "description": "目标CRF值",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 51
            },
            "example": 23
          },
          {
            "name": "preset",
            "in": "query",
            "description": "编码预设",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "ultrafast",
                "fast",
                "medium",
                "slow",
                "veryslow"
              ]
            },
            "example": "medium"
          }
        ],
        "responses": {
          "200": {
            "description": "预测成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": true,
                  "params": {
                    "crf": 23,
                    "preset": "medium",
                    "codec": "h265"
                  },
                  "confidence": 0.82,
                  "estimated_size_mb": 125.6,
                  "estimated_time_seconds": 45.2
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/training/status": {
      "get": {
        "summary": "获取训练状态",
        "description": "获取当前模型训练队列的状态",
        "tags": [
          "training"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "训练状态",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "is_running": true,
                  "current_epoch": 15,
                  "total_epochs": 100,
                  "progress": 0.15,
                  "eta_minutes": 42.5,
                  "current_loss": 0.0234
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/models/register": {
      "post": {
        "summary": "注册新模型",
        "description": "注册新的AI模型版本到系统",
        "tags": [
          "models"
        ],
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "description": "模型名称",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "lightgbm"
          },
          {
            "name": "version",
            "in": "query",
            "description": "模型版本",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "v2.0.0"
          },
          {
            "name": "model_path",
            "in": "query",
            "description": "模型文件路径",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "/models/lightgbm_v2.pth"
          },
          {
            "name": "description",
            "in": "query",
            "description": "模型描述",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "改进的LightGBM模型"
          }
        ],
        "responses": {
          "201": {
            "description": "注册成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": true,
                  "model_id": "lightgbm_v2.0.0",
                  "message": "模型注册成功"
                }
              }
            }
          },
          "409": {
            "description": "模型已存在"
          },
          "400": {
            "description": "注册参数错误"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ]
      }
    },
    "/api/v1/feedback/record": {
      "post": {
        "summary": "记录用户反馈",
        "description": "记录用户对AI预测结果的反馈",
        "tags": [
          "feedback"
        ],
        "parameters": [
          {
            "name": "prediction_id",
            "in": "query",
            "description": "预测ID",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "pred_123456"
          },
          {
            "name": "user_rating",
            "in": "query",
            "description": "用户评分",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "example": 4
          },
          {
            "name": "actual_quality",
            "in": "query",
            "description": "实际质量",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "example": 87
          },
          {
            "name": "comments",
            "in": "query",
            "description": "用户评论",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "预测很准确"
          }
        ],
        "responses": {
          "200": {
            "description": "反馈记录成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "success": true,
                  "feedback_id": "fb_789012",
                  "message": "感谢您的反馈"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/capabilities": {
      "get": {
        "summary": "获取服务能力",
        "description": "获取AI服务支持的功能和格式列表",
        "tags": [
          "system"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "服务能力",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                },
                "example": {
                  "prediction": {
                    "image": true,
                    "video": true,
                    "supported_formats": [
                      "jpg",
                      "png",
                      "webp",
                      "avif",
                      "jxl",
                      "heic"
                    ]
                  },
                  "models": {
                    "lightgbm": true,
                    "ppo": true,
                    "ab_testing": true
                  },
                  "features": {
                    "online_learning": true,
                    "feedback": true,
                    "batch_processing": true
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PredictRequest": {
        "type": "object",
        "required": [
          "image_path"
        ],
        "properties": {
          "image_path": {
            "type": "string",
            "description": "图像文件路径"
          },
          "tool": {
            "type": "string",
            "description": "目标压缩工具"
          },
          "target_quality": {
            "type": "integer",
            "description": "目标质量"
          },
          "optimize_mode": {
            "type": "string",
            "description": "优化模式"
          }
        }
      },
      "PredictResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "params": {
            "type": "object"
          },
          "confidence": {
            "type": "number"
          },
          "model_used": {
            "type": "string"
          },
          "inference_time_ms": {
            "type": "number"
          }
        }
      }
    },
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}